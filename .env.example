# Credit Risk Engine Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATA SOURCES (Optional - defaults to synthetic data)
# =============================================================================

# Lending Club API (for real data mode)
# LENDING_CLUB_API_KEY=your_api_key_here

# Yahoo Finance (for market stress testing)
# YAHOO_FINANCE_ENABLED=true

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model version
MODEL_VERSION=v2.0.0
MODEL_NAME=XGBoost_PD_Model

# Random seed for reproducibility
RANDOM_SEED=42

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path
DATABASE_PATH=./credit_risk.db

# Backup retention (number of backups to keep)
BACKUP_RETENTION=3

# =============================================================================
# PSI MONITORING
# =============================================================================

# PSI thresholds
PSI_STABLE_THRESHOLD=0.10
PSI_WARNING_THRESHOLD=0.25

# Monitoring database
PSI_DB_PATH=./psi_monitoring.db

# =============================================================================
# STREAMLIT DASHBOARD
# =============================================================================

# Dashboard port
STREAMLIT_PORT=8501

# Enable file watcher (disable in production)
STREAMLIT_FILE_WATCHER=false

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file
LOG_FILE=./logs/credit_risk.log

# =============================================================================
# COMPLIANCE
# =============================================================================

# SR 11-7 compliance mode
COMPLIANCE_MODE=enabled

# Audit trail enabled
AUDIT_TRAIL=true
